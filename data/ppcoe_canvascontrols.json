er picture, while providing various unique style options. The key properties for this control are Logo, OnSelectLogo, and Title.","screenshotUrl":"/Image/download.aspx?Entity=ppcoe_canvascontrol&Attribute=ppcoe_screenshot&Id=52137234-4d69-f011-bec1-6045bd141b62&Timestamp=638896498378323461","status":"Active","statusCode":1,"recommendation":"Do not use","recommendationCode":218650001,"isInPreview":true,"isClassic":false,"isAccessible":false,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-08-01T12:57:17Z"},{"id":"54137234-4d69-f011-bec1-6045bd141b62","name":"HTML text","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Can use","recommendationCode":218650000,"isInPreview":false,"isClassic":true,"isAccessible":true,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:47:02Z"},{"id":"56137234-4d69-f011-bec1-6045bd141b62","name":"Icon","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Can use","recommendationCode":218650000,"isInPreview":false,"isClassic":true,"isAccessible":true,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:47:14Z"},{"id":"58137234-4d69-f011-bec1-6045bd141b62","name":"Modern Icon","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":null,"recommendationCode":null,"isInPreview":false,"isClassic":false,"isAccessible":false,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:45:51Z"},{"id":"5a137234-4d69-f011-bec1-6045bd141b62","name":"Image","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":null,"recommendationCode":null,"isInPreview":false,"isClassic":true,"isAccessible":false,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:47:25Z"},{"id":"5c137234-4d69-f011-bec1-6045bd141b62","name":"List Box","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Can use","recommendationCode":218650000,"isInPreview":false,"isClassic":true,"isAccessible":true,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:48:22Z"},{"id":"5e137234-4d69-f011-bec1-6045bd141b62","name":"Map","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Can use with amendments","recommendationCode":218650002,"isInPreview":false,"isClassic":true,"isAccessible":false,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:47:32Z"},{"id":"60137234-4d69-f011-bec1-6045bd141b62","name":"Microphone","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Can use","recommendationCode":218650000,"isInPreview":false,"isClassic":true,"isAccessible":true,"createdOn":"2025-07-25T11:48:15Z","modifiedOn":"2025-10-27T13:48:02Z"},{"id":"62137234-4d69-f011-bec1-6045bd141b62","name":"Number input","description":"Makers can add a number input control to type in or use the arrows to select a number value. They can configure decimal precision and step values for this control. This control provides number type as a default output to build numeric scenarios in Power Apps. A key property for this control is Value.","screenshotUrl":"/Image/download.aspx?Entity=ppcoe_canvascontrol&Attribute=ppcoe_screenshot&Id=62137234-4d69-f011-bec1-6045bd141b62&Timestamp=638896465093020571","status":"Active","statusCode":1,"recommendation":"Avoid using if possible","recommendationCode":218650003,"isInPreview":false,"isClassic":false,"isAccessible":false,"createdOn":"2025-07-25T11:48:16Z","modifiedOn":"2025-10-27T13:51:39Z"},{"id":"64137234-4d69-f011-bec1-6045bd141b62","name":"PDF Viewer","description":null,"screenshotUrl":null,"status":"Active","statusCode":1,"recommendation":"Avoid using if possible","recommendationCode":218650003,"isInPreview":false,"isClassic":false,"isAccessible":false,"createdOn":"2025-07-25T11:48:16Z","modifiedOn":"2025-08-01T12:44:52Z"},{"id":"66137234-4d69-f011-bec1-6045bd141b62","name":"Pen Input","description":null,"screenshotUrl":nu