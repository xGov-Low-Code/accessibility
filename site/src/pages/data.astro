---
import DatasetSummary from "../components/DatasetSummary.astro";
import { canvasControlsSummary, sourceCanvasControlsDataset } from "../data/canvasControls";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="Data"
  description="Source data, export date and refresh process for xGov Low-Code Accessibility."
>
  <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
      <li class="govuk-breadcrumbs__list-item">
        <a class="govuk-breadcrumbs__link" href={withBase("/")}>Home</a>
      </li>
      <li class="govuk-breadcrumbs__list-item">Data</li>
    </ol>
  </nav>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Data</h1>
      <p class="govuk-body-l">
        Source data, export details and publication rules for the Power Apps Canvas Controls catalogue.
      </p>
    </div>
  </div>

  <section class="app-section" aria-labelledby="source-heading">
    <h2 class="govuk-heading-l" id="source-heading">Source dataset</h2>
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Repository path</dt>
        <dd class="govuk-summary-list__value">
          <code>data/canvas-controls/ppcoe_canvascontrols.json</code>
        </dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Source</dt>
        <dd class="govuk-summary-list__value">{sourceCanvasControlsDataset.source}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Table</dt>
        <dd class="govuk-summary-list__value">{sourceCanvasControlsDataset.table}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Schema version</dt>
        <dd class="govuk-summary-list__value">{sourceCanvasControlsDataset.schemaVersion}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Last exported</dt>
        <dd class="govuk-summary-list__value">
          <time datetime={canvasControlsSummary.exportedAtUtc}>{canvasControlsSummary.exportedDate}</time>
        </dd>
      </div>
    </dl>
  </section>

  <DatasetSummary summary={canvasControlsSummary} />

  <section class="app-section" aria-labelledby="process-heading">
    <h2 class="govuk-heading-l" id="process-heading">Update and publication process</h2>
    <ol class="govuk-list govuk-list--number">
      <li>The exported JSON updates automatically each day from the Defra tenant.</li>
      <li>Data contract tests validate the schema, record count, dates, recommendations and slugs.</li>
      <li>Guidance HTML is sanitised at build time before it is rendered.</li>
      <li>The GitHub Pages workflow publishes <code>site/dist</code> after checks pass.</li>
    </ol>
    <p class="govuk-body">
      Inactive controls remain in the source dataset for auditability, but they are excluded from
      public catalogue pages, detail pages, filters and summary counts.
    </p>
  </section>

  <section class="app-section" aria-labelledby="screenshots-heading">
    <h2 class="govuk-heading-l" id="screenshots-heading">Screenshot status</h2>
    <p class="govuk-body">
      The source data includes Dataverse-relative <code>screenshotUrl</code> values. These are not
      rendered until static image assets and suitable alt text are available.
    </p>
  </section>
</BaseLayout>
