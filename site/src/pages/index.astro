---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="Home"
  description="Community-maintained accessibility artefacts and guidance for the xGov Low-Code community."
>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">xGov Low-Code Accessibility</h1>
      <p class="govuk-body-l">
        Community-maintained accessibility artefacts and guidance for low-code makers working in government.
      </p>
    </div>
  </div>

  <section class="app-section" aria-labelledby="guidance-heading">
    <h2 class="govuk-heading-l" id="guidance-heading">Guidance sections</h2>
    <ul class="govuk-list app-section-list">
      <li class="app-section-list__item">
        <h3 class="govuk-heading-m app-section-list__heading">
          <a class="govuk-link" href={withBase("/canvas-controls/")}>
            Power Apps Canvas Controls Accessibility
          </a>
        </h3>
        <p class="govuk-body">
          Search active controls, compare recommendations and read available guidance.
        </p>
        <strong class="govuk-tag govuk-tag--green">Available</strong>
      </li>
    </ul>
  </section>

  <section class="app-section" aria-labelledby="project-heading">
    <h2 class="govuk-heading-l" id="project-heading">Project links</h2>
    <ul class="govuk-list govuk-list--bullet">
      <li><a class="govuk-link" href={withBase("/about/")}>About this community site</a></li>
      <li><a class="govuk-link" href={withBase("/data/")}>Data source and refresh process</a></li>
      <li><a class="govuk-link" href={withBase("/accessibility/")}>Accessibility statement readiness</a></li>
    </ul>
  </section>
</BaseLayout>
