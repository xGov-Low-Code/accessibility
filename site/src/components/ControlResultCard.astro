---
import type { PublicCanvasControl } from "../data/canvasControls";
import AssessmentDate from "./AssessmentDate.astro";
import ControlTypeTag from "./ControlTypeTag.astro";
import RecommendationTag from "./RecommendationTag.astro";

interface Props {
  control: PublicCanvasControl;
}

const { control } = Astro.props;
const accessibleText = control.isAccessible ? "Yes" : "No";
const previewText = control.isInPreview ? "In preview" : "Not in preview";
const guidanceText = control.guidanceHtml ? "Guidance available" : "No guidance available";
---

<article class="app-control-card" id={control.slug}>
  <h3 class="govuk-heading-m app-control-card__heading">{control.name}</h3>
  <p class="govuk-body app-control-card__description">
    {control.description ?? "No description available."}
  </p>

  <ul class="govuk-list app-control-card__tags" aria-label={`${control.name} labels`}>
    <li><RecommendationTag recommendation={control.recommendation} /></li>
    <li><ControlTypeTag type={control.controlType} /></li>
  </ul>

  <dl class="govuk-summary-list app-control-card__metadata">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Accessible</dt>
      <dd class="govuk-summary-list__value">{accessibleText}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Preview</dt>
      <dd class="govuk-summary-list__value">{previewText}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Accessibility assessment</dt>
      <dd class="govuk-summary-list__value">
        <AssessmentDate
          value={control.assessedByAccessibilityTeamOn}
          missingText="Not assessed by accessibility team"
        />
      </dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Guidance</dt>
      <dd class="govuk-summary-list__value">{guidanceText}</dd>
    </div>
  </dl>
</article>
